# Sao chép file này thành .env.local rồi điền giá trị thật.
# KHÔNG commit .env.local lên git.
#
# Lấy URL + anon key tại: Supabase Dashboard -> Project Settings -> API
#   - Project URL      -> VITE_SUPABASE_URL
#   - anon public key  -> VITE_SUPABASE_ANON_KEY
#
# Anon key là khoá công khai, an toàn để nhúng vào web tĩnh; quyền thực thi
# do Row Level Security + RPC quyết định phía Supabase.

VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<anon-public-key>

# 'supabase' để dùng dữ liệu thật; để trống hoặc 'mock' để chạy bằng dữ liệu giả.
VITE_DATA_SOURCE=mock

# Tên miền công khai của app (không có dấu / ở cuối).
# Dùng để sinh link trong mã QR: QR tạo trên máy dev vẫn trỏ về tên miền thật
# thay vì localhost. Ví dụ: https://so-tay-doan-vien.vercel.app
# Bỏ trống thì QR dùng địa chỉ máy đang mở (chỉ đúng khi tạo QR trên production).
VITE_PUBLIC_URL=
